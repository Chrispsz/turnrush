#!/bin/sh
# AppRun do TurnRush: resolve o diretório real e escolhe o binário.
# Flags do simulador → turnrush-sim; qualquer outra coisa → o jogo.
HERE="$(dirname "$(readlink -f "$0")")"
case "$1" in
  --quick|--gate|--match|--formation4v4|--formation-gate|--formation-demo|--probe|--sims|--iters|--threads|--out)
    exec "$HERE/usr/bin/turnrush-sim" "$@" ;;
  *)
    exec "$HERE/usr/bin/turnrush-game" "$@" ;;
esac
